# Supabase (projeto "Clinic Control")
NEXT_PUBLIC_SUPABASE_URL=https://jggfnfxdtfqeqyvxufgu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Credenciais das clinicas ficam na tabela aniversariantes_clinicas (nao em env).
# As variaveis acima sao só para conectar ao Supabase.

# Schema onde vivem as tabelas aniversariantes_*. Existe só para a migracao que
# as tira de `public` (Clinic-Control#71): deployar com o default, mover as
# tabelas, entao definir `aniversariantes` aqui e redeployar. NAO DEFINIR antes
# do move — o app nao acha as tabelas. Default quando ausente: public
# O mesmo valor precisa ser definido no Clinic Control, que le as mesmas tabelas.
ANIVERSARIANTES_DB_SCHEMA=

# Segredo compartilhado com o Vercel Cron (vercel.json) para autenticar o
# GET /api/cron/sync-clinicorp — sem isso a rota rejeita qualquer chamada.
# Gerar um valor aleatorio e cadastrar tambem em Project Settings > Environment
# Variables na Vercel (o Cron usa a env var do proprio projeto, nao o .env.local).
CRON_SECRET=
